# The released application artifact that this infrastructure deploys.
#
# Build once, deploy many: every environment (dev, qa, prod) deploys exactly
# these bytes. To promote a new application release, change both lines in a
# reviewed pull request. app-ci.yml prints the SHA-256 when it publishes a tag.
#
# Deployments refuse to run until LAMBDA_SHA256 is filled in.
LAMBDA_VERSION=1.0.0
LAMBDA_SHA256=
